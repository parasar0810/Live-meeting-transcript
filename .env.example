# Copy this file to .env and fill in your values.

# Required: OpenAI API key for LLM calls and embeddings
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=./knowledge_base/chroma_db
SUPERVISOR_SUMMARY_INTERVAL_CHUNKS=5
SUPERVISOR_SUMMARY_INTERVAL_SECONDS=30
WORK_QUEUE_MAXSIZE=50
CLIENT_QUEUE_MAXSIZE=100
LOG_LEVEL=INFO
ANONYMIZED_TELEMETRY=False
